---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HorizontalScoll from '../components/HorizontalScoll.astro';
import ServicesCard from '../components/ServicesCard.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
const services = (await getCollection('services'));
---

<!doctype html>
<html lang="en">

	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Spectral:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">	
	</head>
	
	<body class="overflow-x-hidden">
		<div id="cursor"></div>
		<section class="h-[100vh]">
			<Header />
			<div class="grid grid-rows-1 md:grid-cols-2 lg:grid-cols-[60%_40%] h-[100%]">
				<div class="grid grid-cols-1 grid-rows-[50vh] md:grid-rows-[60%_40%]">
					<div class="first-background p-10 grid content-center md:content-end">
						<h1 class="text-white font-title">FLORELLA</h1>
						<h2 class="text-white h2-heading font-display">Bouquets from the soul</h2>
					</div>
					<div class="hidden md:grid grid-cols-[70%_30%]">
						<div class="bg-pink flex items-center">
							<img src="../../public/bouquete.svg" class="w-screen md:h-[220px] xl:h-[300px] rotate-90"/>
						</div>
						<div class="bg-green"></div>
					</div>
				</div>
				<div class="second-background grid grid-rows-[50vh] md:grid-rows-2 px-8">
					<div class="hidden md:block"></div>
					<div class="flex items-center justify-center flex-col px-8 pt-16 xl:pt-28">
						<p class="text-white font-title pb-8">
							Florella is a sophisticated and wonderful floristry brand offering a wide range of unique floral arrangements for any occasion.
						</p>
	
						<p class="text-white font-title ps-16">
							Florella has established itself as a brand that appreciates the beauty of nature and strives to convey it in every flower bouquet.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section id="services" class="p-8 hidden md:block h-auto">
			<ul class="grid md:grid-rows-2 lg:grid-rows-[250px_250px] xl:grid-rows-[350px_350px] grid-cols-3 gap-8">
				<li class="flex justify-center items-center">
					<div class="bg-green rounded-full md:h-[200px] xl:h-[300px] md:w-[200px] xl:w-[300px] flex justify-center items-center">
						<h2 class="m-0 text-white flex justify-center items-center font-display">Services</h2>
					</div>
				</li>
					{services.map((item) => <ServicesCard image={item?.data.heroImage} title={item?.data.title} description={item?.data.description}/>)}
			</ul>
		</section>

		<section id="services" class="p-8 block md:hidden h-auto">
			<div class="grid grid-rows-1 justify-center">
				<div class="bg-green rounded-full h-[200px] w-[200px] flex justify-center items-center">
					<h2 class="m-0 text-white flex justify-center items-center font-display">Services</h2>
				</div>
			</div>

			<ul class="grid grid-cols-1 grid-rows-5 pt-8 gap-8">
				{services.map((service) => <ServicesCard image={service?.data.heroImage} title={service?.data.title} description={service?.data.description}/>)}
			</ul>
			
		</section>

		<section id="team" class="h-auto md:h-[100vh]">
			<div class="grid grid-rows-1 md:grid-cols-2 xl:grid-cols-[1fr_2fr] h-[100%]">
				<div class="bg-green px-8 pt-36 pb-12 grid grid-rows-2">
					<div>
						<h2 class="text-white font-title"><i>TEAM</i></h2>
						<p class="text-white py-8 font-title">
							<i>
							Florella professionals carefully select each flower, using only the freshest and highest quality plants, and create works of art that can express any emotion without words.
							</i>
						</p>
						<p class="text-white md:ps-16 font-title">
							<i>
							Florella artists strive to capture the magic essence of the moment, helping customers embody the feelings in flowers.
							</i>
						</p>
					</div>
					<div class="place-self-end xl:place-self-center">
						<img src="/public/flower.svg" class="w-screen h-[30vh]"/>
					</div>
				</div>
				<div class="grid grid-cols-1 grid-rows-[1.5fr_1fr]">
					<div class="third-background"></div>
					<div class="fourth-background flex justify-center md:justify-end items-end p-8">
						<div class="bg-pink rounded-full w-[200px] h-[200px] flex justify-center items-center">
							<p class="text-green flex justify-center items-center m-0 text-center font-normal not-italic">Team <br> of professionals</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="horizontal_scroll" class="grid content-center h-[30vh] md:h-[50vh]">
			<HorizontalScoll border="border-green border-t-[1px]"/>
			<HorizontalScoll border="border-green border-t-[1px]"/>
			<HorizontalScoll border="border-green border-y-[1px]" />
		</section>

		<Footer />
	</body>
</html>


<script src="/src/javascript/animations.js"></script>